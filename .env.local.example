# Copie este arquivo para .env.local e preencha com as chaves do seu projeto
# no Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada somente no servidor por scripts administrativos e jobs agendados.
SUPABASE_SERVICE_ROLE_KEY=

# Envio das propostas pelo Microsoft 365 / Microsoft Graph.
# São variáveis SOMENTE de servidor: nunca use prefixo NEXT_PUBLIC_.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=

# Relatório diário de governança de marcas.
NEXT_PUBLIC_APP_URL=
CRON_SECRET=
RELATORIO_MARCAS_EMAILS=

# Integração com o Hub Amplificado (Multi-Zones): destino do rewrite /amplificado.
URL_HUB_AMPLIFICADO=https://hub-amplificado.vercel.app

# Login mock compartilhado com o Hub (SÓ desenvolvimento; ignorado em produção).
# Com =1 o login usa a carteira de src/lib/mock-sessao/carteira.ts (qualquer
# senha não vazia) e o servidor passa a exigir SUPABASE_SERVICE_ROLE_KEY.
# Deixe vazio para usar o Supabase Auth normal.
NEXT_PUBLIC_LOGIN_MOCK=
