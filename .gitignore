next-env.d.ts

# Área de trabalho do processo de desenvolvimento (ledger, scripts descartáveis
# e backups do banco). Contém `backup-*/clientes.json`, com CNPJ e e-mails
# nominais dos 15.519 clientes da carteira — 4 MB de dado pessoal que um
# `git add -A` levaria para o histórico sem ninguém perceber. Nada aqui é
# código do produto: o que precisa ser versionado (schema, seed, documentação)
# mora em `supabase/` e `docs/`.
.superpowers/

# Planilhas de trabalho: contêm CNPJ e e-mails nominais. Nunca versionar.
# Ancorada na raiz (`/dados/`) de propósito: sem a barra, a regra também
# casaria `src/lib/dados/`, que é código-fonte, não planilha.
/dados/

# Seed gerado da carteira de clientes: contém CNPJ e e-mails nominais de
# executivos. Nunca versionar — só o seed-formatos.sql (dado não sensível) vai
# para o repositório.
supabase/seed-clientes.sql

# Anotações com senha do banco salvas na raiz do projeto. Segredo nenhum
# entra no repositório.
Database password*.txt

# Exportações da API do Globo Take salvas pelo navegador para alimentar
# `npm run importar -- --arquivo`. São dados comerciais (anunciante, marca,
# custos de produção, elenco) e podem ter dezenas de MB. Ficam só na máquina.
/vendas*.json
/*-globotake*.json

# Artefatos do Office e do OneDrive
~$*
*.tmp
.worktrees/

# Cloudflare (OpenNext / wrangler)
.open-next/
.wrangler/
.dev.vars
